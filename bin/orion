#!/usr/bin/env bash

# This file is a wrapper that points to the actual orion installed in user's home
# On first run, it will install the full orion to ~/.orion/

set -e

INSTALL_DIR="$HOME/.orion"

# Check if already installed
if [ -f "$INSTALL_DIR/orion" ]; then
    exec "$INSTALL_DIR/orion" "$@"
fi

# First run - install
echo "🚀 First run detected. Installing orion..."
echo ""

# Create directory
mkdir -p "$INSTALL_DIR"

# Copy the installer and run it
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cp "$SCRIPT_DIR/../install-orion.sh" "$INSTALL_DIR/"

cd "$INSTALL_DIR"
./install-orion.sh

# Run the installed version
exec "$INSTALL_DIR/orion" "$@"
